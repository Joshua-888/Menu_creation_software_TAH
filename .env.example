# TakeAwayHero Menu Operator Portal — copy to .env (never commit real secrets)

# Required in production (min 16 chars)
PORTAL_SESSION_SECRET=change-me-to-a-long-random-string

# First admin login (created on boot if email not present)
ADMIN_BOOTSTRAP_EMAIL=you@takeawayhero.example
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password
ADMIN_BOOTSTRAP_NAME=Portal Admin

# Optional paths (Railway: mount volume at /data)
# PORTAL_DATA_DIR=/data/portal
# PORTAL_DB_PATH=/data/portal/portal.sqlite
# PORTAL_UPLOADS_DIR=/data/portal/uploads
# PORTAL_RUNS_DIR=/data/portal/runs
# PORTAL_REPO_ROOT=/app

# Optional: wire review answers into an existing DecisionStore sqlite
# PORTAL_DECISION_DB_PATH=/data/decisions.sqlite

# Optional: force Secure cookies (default on when NODE_ENV=production)
# PORTAL_COOKIE_SECURE=true

# Optional: gated live admin writes (default off — dry-run only)
# PORTAL_LIVE_WRITES=1
# Requires allowlisted destination host (veronipizza.dk) + TAH_ADMIN_* credentials

# Engine / admin discovery + M6.7 createCategory cert / live executor
# TAH_ADMIN_EMAIL=
# TAH_ADMIN_PASSWORD=
# TAH_ADMIN_BASE_URL=https://veronipizza.dk
# TAH_ADMIN_MENU_PATH=/admin/menu
# DRY_RUN=true
