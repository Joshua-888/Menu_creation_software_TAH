# TakeAwayHero Menu Operator Portal — copy to .env (never commit real secrets)

# Required in production (min 16 chars)
PORTAL_SESSION_SECRET=change-me-to-a-long-random-string

# First admin login (created on boot if email not present)
ADMIN_BOOTSTRAP_EMAIL=you@takeawayhero.example
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password
ADMIN_BOOTSTRAP_NAME=Portal Admin

# Optional paths (Railway: mount volume at /data)
# PORTAL_DATA_DIR=/data/portal
# PORTAL_DB_PATH=/data/portal/portal.sqlite
# PORTAL_UPLOADS_DIR=/data/portal/uploads
# PORTAL_RUNS_DIR=/data/portal/runs
# PORTAL_REPO_ROOT=/app

# Optional: wire review answers into an existing DecisionStore sqlite
# PORTAL_DECISION_DB_PATH=/data/decisions.sqlite

# Optional: force Secure cookies (default on when NODE_ENV=production)
# PORTAL_COOKIE_SECURE=true

# --- Live admin (on by default when TAH_ADMIN_* is set) ---
# Kill switches (optional):
# PORTAL_LIVE_WRITES=0
# PORTAL_DRYRUN_LIVE_DEST=0
# Comma-separated destination hosts (veronipizza.dk is included by default)
# PORTAL_LIVE_WRITE_HOSTS=merchant1.dk,merchant2.dk
# When STRICT=1, only PORTAL_LIVE_WRITE_HOSTS (no automatic veronipizza.dk)
# PORTAL_LIVE_WRITE_HOSTS_STRICT=1
# Only seed Veroni-style default Tilbehør for listed hosts (never invent for new shops)
# PORTAL_SEED_DEFAULT_TILBEHOR_HOSTS=
# Peer probability strip/remap: Veroni only by default. Opt in hosts or set =1 for all.
# PORTAL_APPLY_PEER_PROBABILITY_HOSTS=
# PORTAL_APPLY_PEER_PROBABILITY=1

# Engine / admin login — required for live dry-run + writes
# TAH_ADMIN_EMAIL=
# TAH_ADMIN_PASSWORD=
# TAH_ADMIN_BASE_URL=https://merchant1.dk
# TAH_ADMIN_MENU_PATH=/admin/menu

# Peer structure live fan-out (optional; off for simple multi-merchant create)
# STRUCTURE_WRITE_REQUIRED=1
# STRUCTURE_WRITE_CONFIRMED=1
# STRUCTURE_WRITE_FINGERPRINT=

# M71 peer-menu structure learning (same TAH_ADMIN_* login works on all customers)
# Comma-separated storefront/base URLs — read-only observe, never writes to peers
# PEER_MENU_URLS=https://best-customer-a.dk,https://best-customer-b.dk,https://best-customer-c.dk
# Then run: npm run m71:peer-observe

# See docs/MULTI_MERCHANT_GO_LIVE.md for the two-merchant production test checklist.
